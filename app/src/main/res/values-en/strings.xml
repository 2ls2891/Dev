    <string name="rules_title">How to play</string>
    <string name="rules_1_title">Number = run of filled cells</string>
    <string name="rules_1_text">A 3 next to a line means 3 cells in a row are filled in that line.</string>
    <string name="rules_2_title">Several numbers need gaps</string>
    <string name="rules_2_text">2 1 means a run of 2, at least one empty cell, then a run of 1 — in that order.</string>
    <string name="rules_3_title">Mark sure-empty cells with ✕</string>
    <string name="rules_3_text">Crosses help your reasoning. They don\'t affect the solution check.</string>
    <string name="rules_4_title">Match every row and column</string>
    <string name="rules_4_text">Every puzzle can be solved by logic alone — no guessing. A hidden color picture appears when you finish!</string>
    <string name="rules_color_title">Color puzzles</string>
    <string name="rules_color_text">The clue color is the color to fill. Runs of different colors may touch.</string>

    <string name="tutorial_title">Learn the rules</string>
    <string name="tutorial_skip">Skip</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_intro_title">Draw pictures with numbers</string>
    <string name="tutorial_intro_text">Fill cells using the numbers on each line as clues, and a hidden picture appears.</string>
    <string name="tutorial_practice_title">Try it yourself</string>
    <string name="tutorial_practice_text">Top numbers are for columns, left numbers for rows. Start with the lines of 5!</string>
    <string name="tutorial_done_title">Great job! 🎉</string>
    <string name="tutorial_done_button">Start playing</string>

